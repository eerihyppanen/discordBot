{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for PUBG, Colonist, legendary skins, XP, economy and reminders",
  "type": "module",
  "scripts": {
    "build": "rm -rf build && esbuild src/*.js src/**/*.js --platform=node --format=esm --outdir=build --outbase=src",
    "start": "npm run build && node -r dotenv/config build/app.js",
    "dev": "nodemon",
    "prod": "node build/app.js",
    "test": "node --test tests/*.test.js",
    "deploy-commands": "node deploy-commands.mjs"
  },
  "keywords": [
    "discord",
    "bot",
    "javascript",
    "nodejs"
  ],
  "author": "Shubham Jaiswal <@shubhamjaiswal27>",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "dotenv": "^16.0.2",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
